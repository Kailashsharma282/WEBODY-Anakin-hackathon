# ====================================================================
# WEBODY — Environment Configuration Reference (.env.example)
# Hackathon: Anakin Forge | Participant: Pochiraju Kailash Ram Markandeya Sharma
# ====================================================================

# --------------------------------------------------------------------
# 1. ANAKIN.IO API CREDENTIALS (MANDATORY FOR LIVE SURVEILLANCE & RESEARCH)
# Obtain your key at: https://anakin.io (or dashboard.anakin.io)
# --------------------------------------------------------------------
ANAKIN_API_KEY=your_official_anakin_api_key_here
ANAKIN_BASE_URL=https://api.anakin.io
ANAKIN_TIMEOUT=30.0
ANAKIN_MAX_RETRIES=3

# --------------------------------------------------------------------
# 2. STRATEGIC BRAND & COMPETITOR CONFIGURATION (DEFAULTS TO ANTHROPIC vs OPENAI)
# --------------------------------------------------------------------
DEFAULT_BRAND_NAME=Anthropic
DEFAULT_BRAND_DOMAIN=anthropic.com
DEFAULT_COMPETITOR_NAME=OpenAI
DEFAULT_COMPETITOR_DOMAIN=openai.com

# --------------------------------------------------------------------
# 3. LIVE EXTERNAL CONNECTOR CREDENTIALS (OPTIONAL FOR REAL DISPATCH)
# When provided, Wire actions will dispatch live to real external systems!
# --------------------------------------------------------------------
# GitHub Personal Access Token (classic with repo scope or fine-grained Issues write)
# GITHUB_TOKEN=ghp_your_github_token_here

# Slack Incoming Webhook URL (e.g. https://hooks.slack.com/services/T000/B000/XXXX)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# Default: SQLite asynchronous database (zero external setup required)
# --------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./webody.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/webody

# --------------------------------------------------------------------
# 5. FASTAPI BACKEND SERVER CONFIGURATION
# --------------------------------------------------------------------
PORT=8008
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8008

# --------------------------------------------------------------------
# 6. NEXT.JS FRONTEND CONFIGURATION
# --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8008
NEXT_PUBLIC_WS_PORT=8008
NEXT_PUBLIC_APP_NAME="WEBODY — Living Autonomous Corporate Defense OS"
