# WEBODY — Environment Configuration Template
# Hackathon: Anakin Forge | Participant: Pochiraju Kailash Ram Markandeya Sharma | Team: kailashsharma

# -------------------------------------------------------------
# 1. ANAKIN API CREDENTIALS (Strictly backend only, never exposed to browser)
# -------------------------------------------------------------
ANAKIN_API_KEY=your_official_anakin_api_key_here
ANAKIN_BASE_URL=https://api.anakin.io
ANAKIN_TIMEOUT=30.0
ANAKIN_MAX_RETRIES=3

# -------------------------------------------------------------
# 2. DATABASE & REDIS
# -------------------------------------------------------------
# SQLite (Local Development Default):
DATABASE_URL=sqlite+aiosqlite:///./webody.db

# PostgreSQL (Production / Railway / Render):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/webody

# Redis (Managed / Upstash):
# REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------
# 3. FASTAPI SERVER CONFIG
# -------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# -------------------------------------------------------------
# 4. FRONTEND CONFIG
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="WEBODY — Living Operating System"
